# Copiá este archivo como .env y completá solamente los servicios que uses.
# Nunca publiques el archivo .env real.

# Identidad local opcional
REBECCA_OWNER_NAME=Usuario

# Telegram
TELEGRAM_BOT_TOKEN=
CHAT_ID=

# Modelos y servicios de voz
GEMINI_API_KEY=
GEMINI_API_KEY_BOCA=
FISH_AUDIO_API_KEY=
REBECCA_MODEL_ID=
API_FOOTBALL_KEY=
REBECCA_LIVE_MODEL=gemini-3.5-flash-live
REBECCA_LIVE_VISION=1

# Correo del negocio
EMAIL_USUARIO=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Rebecca
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Por defecto todo queda local. Configurá HTTPS sólo si entendés la exposición.
PUBLIC_BASE_URL=http://127.0.0.1:8000
DASHBOARD_ACCESS_TOKEN=
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000

# Archivos y límites
MESA_TRABAJO=
MAX_PDF_TELEGRAM_MB=20
MAX_COMPROBANTE_MB=12
REBECCA_COMMENT_LOG=1
